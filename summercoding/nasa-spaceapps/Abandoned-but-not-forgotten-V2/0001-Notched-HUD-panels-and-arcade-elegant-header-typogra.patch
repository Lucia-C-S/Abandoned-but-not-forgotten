From ebb50d4800b4c9f9d269c266040e2b2bcd4666c3 Mon Sep 17 00:00:00 2001
From: claude <c@x>
Date: Sun, 8 Nov 2026 17:34:22 +0000
Subject: [PATCH] Notched HUD panels and arcade/elegant header typography

---
 retro-cosmos.css | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/retro-cosmos.css b/retro-cosmos.css
index 1d9b5e6..a768d31 100644
--- a/retro-cosmos.css
+++ b/retro-cosmos.css
@@ -1,3 +1,4 @@
+@import url("https://fonts.googleapis.com/css2?family=Michroma&family=Silkscreen:wght@400;700&family=Syncopate:wght@700&display=swap");
 /* RETRO-COSMOS: visual layer loaded AFTER portfolio.css. Markup/IDs/JS untouched.
    Disable everything: add ?motion=off to the URL or set prefers-reduced-motion. */
 :root{--black:#060616;--panel:#0c0c26;--silver:#e2e5ff;--muted:#9296c2;--line:#2a2c60;
@@ -66,3 +67,31 @@ input:focus,select:focus,textarea:focus{border-color:var(--green);box-shadow:var
 @media(prefers-reduced-motion:reduce){.rc-nebula,.rc-grid::before,.rc-shoot,.scanlines::after,.signal-dot,.live-dot{animation:none!important}
 .rc-shoot{display:none}.rc-planet{transition:none}}
 html[data-motion="off"] .rc-layer,html[data-motion="off"] .scanlines::after{display:none}
+
+/* ===== v2: NOTCHED PANELS + ARCADE/ELEGANT TYPOGRAPHY ===== */
+/* Text panels: two chamfered corners (top-left, bottom-right) and thin HUD brackets on the
+   other two. Brackets grow on hover (--l is animated via @property). */
+@property --l{syntax:"<length>";inherits:false;initial-value:14px}
+.world-banner,.story-grid>*,.status-row,.ledger-row,.section-aside,.timeline-content{
+--b:#37e8ffaa;--l:14px;border:0;box-shadow:none;
+clip-path:polygon(12px 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%,0 12px);
+background:
+linear-gradient(var(--b),var(--b))right top/var(--l) 1.5px no-repeat,
+linear-gradient(var(--b),var(--b))right top/1.5px var(--l) no-repeat,
+linear-gradient(var(--b),var(--b))left bottom/var(--l) 1.5px no-repeat,
+linear-gradient(var(--b),var(--b))left bottom/1.5px var(--l) no-repeat,
+linear-gradient(160deg,#12123acc,#0a0a22b3);
+transition:transform .3s,--l .3s}
+.story-grid>*:hover,.status-row:hover,.ledger-row:hover,.timeline-content:hover{
+--b:#ff3ec9;--l:26px;box-shadow:none;border:0}
+.brand-mark{clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px);box-shadow:none}
+
+/* Typography: wide geometric caps for h1, Michroma for h2/h3, pixel face for small labels,
+   italic serif kept for emphasis words. */
+:root{--display:"Michroma","Orbitron",sans-serif;--pixel:"Silkscreen","DM Mono",monospace}
+h1{font:700 clamp(26px,4.2vw,56px)/1.15 "Syncopate","Michroma",sans-serif;letter-spacing:.02em;text-transform:uppercase}
+h2{font:400 clamp(19px,2.3vw,32px)/1.25 var(--display);letter-spacing:.03em}
+h3{font-family:var(--display);letter-spacing:.04em}
+h1 em,h2 em{font-family:Georgia,"Times New Roman",serif;font-style:italic;text-transform:none;letter-spacing:0}
+.eyebrow,.section-index,.status-code,.world-code,.timeline-year,.nav-index,.window-top>span{
+font-family:var(--pixel);font-size:11px;letter-spacing:.12em}
-- 
2.43.0

