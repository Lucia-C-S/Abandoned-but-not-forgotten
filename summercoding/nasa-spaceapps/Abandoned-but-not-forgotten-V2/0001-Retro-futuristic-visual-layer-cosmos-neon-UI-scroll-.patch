+/* RETRO-COSMOS: visual layer loaded AFTER portfolio.css. Markup/IDs/JS untouched.
+   Disable everything: add ?motion=off to the URL or set prefers-reduced-motion. */
+:root{--black:#060616;--panel:#0c0c26;--silver:#e2e5ff;--muted:#9296c2;--line:#2a2c60;
+--green:#37e8ff;--green-soft:#3b8fb4;--magenta:#ff3ec9;--violet:#8a5cff;
+--glow:0 0 18px #37e8ff55,0 0 2px #37e8ff}
+body{background:radial-gradient(120% 80% at 50% -10%,#14123f 0%,#060616 60%)fixed,#060616}
+/* ---------- cosmic layers (injected by retro-cosmos.js) ---------- */
+.rc-layer{position:fixed;inset:0;z-index:-2;overflow:hidden;pointer-events:none;contain:strict}
+.rc-nebula{position:absolute;inset:-20%;opacity:.55;animation:rc-drift 90s ease-in-out infinite alternate;
+background:radial-gradient(40% 35% at 25% 30%,#8a5cff55,transparent 70%),
+radial-gradient(35% 30% at 78% 22%,#ff3ec944,transparent 70%),
+radial-gradient(45% 40% at 60% 85%,#37e8ff33,transparent 70%)}
+.rc-planet{position:absolute;border-radius:50%;opacity:var(--o,0);will-change:transform,opacity;
+transform:translate3d(0,0,0)scale(var(--s,.6))}
+.rc-p1{top:14%;right:9%;width:min(34vw,380px);aspect-ratio:1;
+background:radial-gradient(circle at 32% 30%,#ffb3f0,#b13fd0 38%,#3a1a7a 72%,#120a33);
+box-shadow:0 0 60px #ff3ec955,inset -30px -20px 60px #05051a}
+.rc-p1::after{content:"";position:absolute;inset:-18% -45%;border:2px solid #37e8ff88;border-radius:50%;
+transform:rotateX(74deg)rotateZ(-14deg);box-shadow:0 0 22px #37e8ff66}
+.rc-p2{bottom:18%;left:6%;width:min(20vw,220px);aspect-ratio:1;
+background:radial-gradient(circle at 35% 30%,#bff6ff,#2aa5d6 40%,#14307a 75%,#070b25);
+box-shadow:0 0 50px #37e8ff55,inset -18px -12px 40px #04061a}
+.rc-grid{position:absolute;left:-50%;right:-50%;bottom:-8vh;height:46vh;opacity:.5;
+-webkit-mask-image:linear-gradient(to top,#000 5%,transparent 85%);mask-image:linear-gradient(to top,#000 5%,transparent 85%);
+transform:perspective(420px)rotateX(62deg);transform-origin:50% 100%}
+.rc-grid::before{content:"";position:absolute;inset:-48px 0 0;animation:rc-grid 4.5s linear infinite;
+background:linear-gradient(#ff3ec955 1px,transparent 1px)0 0/100% 48px,linear-gradient(90deg,#37e8ff55 1px,transparent 1px)0 0/48px 100%}
+.rc-shoot{position:absolute;width:140px;height:2px;border-radius:2px;opacity:0;
+background:linear-gradient(90deg,transparent,#fff,#37e8ff);transform:rotate(28deg);animation:rc-shoot 1.1s ease-out forwards}
+@keyframes rc-drift{to{transform:translate3d(-4%,3%,0)scale(1.08)}}
+@keyframes rc-grid{to{transform:translateY(48px)}}
+@keyframes rc-shoot{0%{opacity:0;translate:0 0}15%{opacity:1}100%{opacity:0;translate:-420px 230px}}
+/* ---------- neon UI treatment ---------- */
+h1,h2{text-shadow:0 0 28px #8a5cff66,1px 0 #ff3ec92e,-1px 0 #37e8ff2e}
+h1 em,h2 em,.eyebrow,.spark{text-shadow:var(--glow)}
+.site-header,.sidebar{background:#07071bcc;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
+border-image:linear-gradient(90deg,transparent,#37e8ff77,#ff3ec977,transparent)1}
+.brand-mark{box-shadow:var(--glow),inset 0 0 12px #37e8ff22;border-color:var(--green)}
+.nav-link.active,.primary-nav a.active,.primary-nav [aria-current]{color:#fff;text-shadow:var(--glow);
+box-shadow:inset 2px 0 var(--green),0 8px 20px -14px #37e8ff}
+.button-primary{background:linear-gradient(100deg,#37e8ff,#8a5cff);border-color:transparent;color:#06061a;
+transition:transform .2s,box-shadow .25s}
+.button-primary:hover{transform:translateY(-2px);box-shadow:0 0 26px #37e8ff77,0 0 46px #ff3ec944}
+.button-primary:active{transform:translateY(0)scale(.98)}
+.button:not(.button-primary),.filter-button{border-color:#37e8ff66;transition:box-shadow .25s,border-color .25s,background .25s}
+.button:not(.button-primary):hover,.filter-button:hover,.filter-button.active{border-color:var(--magenta);
+box-shadow:0 0 16px #ff3ec955;background:#ff3ec912}
+.hero-window,.world-banner,.story-grid>*,.status-row,.ledger-row,.section-aside,.timeline-content{
+background:linear-gradient(160deg,#12123acc,#0a0a22b3);border:1px solid #37e8ff3a;
+box-shadow:0 0 0 1px #8a5cff14,0 12px 40px -18px #000,inset 0 0 30px #37e8ff0a;
+transition:transform .3s,border-color .3s,box-shadow .3s}
+.story-grid>*:hover,.status-row:hover,.ledger-row:hover,.timeline-content:hover{transform:translateY(-3px);
+border-color:#ff3ec988;box-shadow:0 0 24px #ff3ec933,0 18px 44px -18px #000,inset 0 0 34px #8a5cff14}
+.signal-dot,.live-dot{background:var(--green);box-shadow:0 0 12px var(--green);animation:rc-pulse 2.4s ease-in-out infinite}
+@keyframes rc-pulse{50%{opacity:.45;box-shadow:0 0 3px var(--green)}}
+.scanlines{opacity:.09;background-image:repeating-linear-gradient(to bottom,transparent 0 3px,#37e8ff1f 3px 4px)}
+.scanlines::after{content:"";position:absolute;inset:0 0 auto;height:18vh;opacity:.5;
+background:linear-gradient(transparent,#37e8ff14,transparent);animation:rc-scan 9s linear infinite}
+@keyframes rc-scan{from{transform:translateY(-20vh)}to{transform:translateY(110vh)}}
+a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{
+outline:2px solid var(--magenta);outline-offset:3px;box-shadow:0 0 14px #ff3ec988}
+input,select,textarea{background:#0a0a24;border:1px solid #37e8ff55;color:var(--silver)}
+input:focus,select:focus,textarea:focus{border-color:var(--green);box-shadow:var(--glow)}
+::selection{background:#8a5cff;color:#fff}
+@media(max-width:700px){.rc-p2,.rc-grid{display:none}.rc-p1{width:52vw}}
+@media(prefers-reduced-motion:reduce){.rc-nebula,.rc-grid::before,.rc-shoot,.scanlines::after,.signal-dot,.live-dot{animation:none!important}
+.rc-shoot{display:none}.rc-planet{transition:none}}
+html[data-motion="off"] .rc-layer,html[data-motion="off"] .scanlines::after{display:none}
diff --git a/retro-cosmos.js b/retro-cosmos.js
new file mode 100644
index 0000000..546a366
--- /dev/null
+++ b/retro-cosmos.js
@@ -0,0 +1,33 @@
+/* RETRO-COSMOS: injects the cosmic layers, drives planets from scroll, fires shooting stars.
+   Pure decoration: touches no existing element. Add ?motion=off to disable. */
+(() => {
+  if (new URLSearchParams(location.search).get("motion") === "off") { document.documentElement.dataset.motion = "off"; return; }
+  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
+  const layer = document.createElement("div");
+  layer.className = "rc-layer"; layer.setAttribute("aria-hidden", "true");
+  layer.innerHTML = '<div class="rc-nebula"></div><div class="rc-grid"></div><div class="rc-planet rc-p1"></div><div class="rc-planet rc-p2"></div>';
+  document.body.prepend(layer);
+  const planets = [[layer.querySelector(".rc-p1"), 0.38], [layer.querySelector(".rc-p2"), 0.78]]; // [element, scroll centre 0-1]
+  let ticking = false;
+  // A planet fades in, grows as the reader "approaches" it, then dissolves past its centre.
+  const update = () => {
+    const max = document.documentElement.scrollHeight - innerHeight;
+    const s = max > 0 ? scrollY / max : 0;
+    planets.forEach(([el, c]) => {
+      const t = Math.max(0, 1 - Math.abs(s - c) / 0.3);
+      el.style.setProperty("--o", (still ? Math.min(t, .6) : t).toFixed(3));
+      el.style.setProperty("--s", (0.55 + Math.max(0, Math.min(1, (s - (c - 0.3)) / 0.6)) * 1.1).toFixed(3));
+    });
+    ticking = false;
+  };
+  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
+  addEventListener("resize", update); update();
+  if (still) return;
+  const shoot = () => {
+    if (document.hidden) return;
+    const s = document.createElement("i"); s.className = "rc-shoot";
+    s.style.left = 40 + Math.random() * 55 + "%"; s.style.top = Math.random() * 40 + "%";
+    layer.append(s); s.addEventListener("animationend", () => s.remove());
+  };
+  (function loop() { setTimeout(() => { shoot(); loop(); }, 7000 + Math.random() * 9000); })();
+})();
